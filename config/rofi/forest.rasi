/* Forest colors, Quiet Fracture layout: search bar + icon grid */
* {
  bg:      #0b1612f2;
  surface: #10201a;
  hover:   #172a22;
  sel:     #24382d;
  border-c:#a2c56e33;
  fg:      #d6e6cf;
  muted:   #6f8a73;
  accent:  #a2c56e;

  background-color: transparent;
  text-color: @fg;
  font: "JetBrainsMono Nerd Font 11";
}

window {
  width: 720px;
  background-color: @bg;
  border: 1px;
  border-color: @border-c;
  border-radius: 10px;
  padding: 16px;
}

mainbox { spacing: 14px; children: [ inputbar, listview ]; }

inputbar {
  background-color: @surface;
  border-radius: 6px;
  padding: 12px 16px;
  children: [ entry ];
}
entry { placeholder: "Search"; placeholder-color: @muted; cursor: text; }

listview {
  columns: 4;
  lines: 3;
  spacing: 6px;
  fixed-columns: true;
  fixed-height: true;
  scrollbar: false;
  flow: horizontal;
}

element {
  orientation: vertical;
  padding: 16px 8px;
  spacing: 10px;
  border-radius: 8px;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @sel; }
element-icon { size: 40px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
